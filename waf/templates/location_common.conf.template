# ------------------------------------------------------------------------------
# 1. Endpoints de Verificação Interna de Saúde e Métricas
# ------------------------------------------------------------------------------
location /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "OK";
}

location /metrics/nginx {
    access_log off;
    allow ${METRICS_ALLOW_FROM};
    deny ${METRICS_DENY_FROM};
    proxy_store off;
    stub_status;
}

# ------------------------------------------------------------------------------
# 2. Bloqueio Total de Robôs de Busca (Robots.txt)
# ------------------------------------------------------------------------------
location = /robots.txt {
    default_type text/plain;
    return 200 "User-agent: *\nDisallow: /\n";
}

# ------------------------------------------------------------------------------
# 3. ARMADILHAS HONEYPOT COM GZIP BOMB (Trava scanners e scrapers automáticos)
# ------------------------------------------------------------------------------
location ~* ^/(wp-login\.php|wp-admin|phpmyadmin|pma|adminer|actuator|_profiler|\.git|IIS_Admin_Portal_v2|Core_Backup_2025|web\.config\.bak) {
    access_log off;
    add_header Content-Encoding gzip;
    add_header Content-Type text/html;
    add_header X-Honeypot-Trapped "Malicious scanner trapped by Decompression Bomb";
    return 200 /usr/share/nginx/html/errors/honeypot_bomb.gzip;
}

# ------------------------------------------------------------------------------
# 4. BURACO NEGRO (Loop 301) para Scanners Caçando Arquivos e Extensões Críticas
# ------------------------------------------------------------------------------
location ~* \.(env|bak|sql|git|ini|swp|yml|yaml|conf|log|sh|bat|dist|orig|save)$ {
    access_log off;
    return 301 $scheme://$host$request_uri;
}

# ------------------------------------------------------------------------------
# 5. Páginas de Erro Nativas Idênticas ao Microsoft-IIS (Camuflagem Fidedigna)
# ------------------------------------------------------------------------------
proxy_intercept_errors on;
error_page 403 /custom_403.html;
error_page 404 /custom_404.html;
error_page 500 502 503 504 /custom_500.html;

location = /custom_403.html { root /usr/share/nginx/html/errors; internal; }
location = /custom_404.html { root /usr/share/nginx/html/errors; internal; }
location = /custom_500.html { root /usr/share/nginx/html/errors; internal; }
