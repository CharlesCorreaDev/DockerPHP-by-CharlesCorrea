# Build adaptado do Moqesh para este projeto.
# - Corrige o Dockerfile upstream (hatchling exige LICENSE/README no build)
# - Fuso horario de Brasilia e locale pt-BR
# Contexto: ./honeypot/IA/moqesh (git clone do repositorio oficial)

FROM node:20-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    TZ=America/Sao_Paulo \
    LANG=pt_BR.UTF-8 \
    LC_ALL=pt_BR.UTF-8 \
    MOQESH_DB_PATH=/app/data/moqesh.db \
    MOQESH_WEB_DIST=/app/web/dist \
    MOQESH_ENFORCE_BLOCK=true

RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata locales \
 && sed -i 's/# pt_BR.UTF-8/pt_BR.UTF-8/' /etc/locale.gen && locale-gen \
 && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml LICENSE NOTICE README.md ./
COPY moqesh/ ./moqesh/
RUN pip install --no-cache-dir .

COPY --from=web /web/dist ./web/dist
RUN mkdir -p /app/data /app/moqesh/assets

EXPOSE 5000 8080
CMD ["moqesh"]

