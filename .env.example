# ==============================================================================
# CONFIGURAÇÕES DO AMBIENTE DOCKER PHP ENTERPRISE (.env)
# ==============================================================================

# Versão do PHP ativa no Traefik (7.4, 8.2, 8.3, 8.4, 8.5)
PHP_ACTIVE_VERSION=8.2

# Quantidade de instâncias para Load Balancing da aplicação
APP_REPLICAS=1

# Domínio e E-mail para SSL
DOMAIN=localhost
LETSENCRYPT_EMAIL=charlescorreaweb@gmail.com

# Modo de SSL: "local" (mkcert/openssl auto-assinado em ./certs) ou "letsencrypt" (produção)
SSL_MODE=local

# Habilitar Cache no Traefik (true / false)
ENABLE_CACHE=true
CACHE_EXPIRY=300

# Limites de Taxa e Segurança (Rate Limit & Bandwidth)
RATE_LIMIT_AVERAGE=50
RATE_LIMIT_BURST=100
BANDWIDTH_LIMIT_KB=0

# Proteção de Bloqueio Geográfico (Lista separada por vírgula de códigos ISO 3166-1)
# Se GEOBLOCK_BLACKLIST=true, bloqueia os países listados.
GEOBLOCK_ENABLED=false
GEOBLOCK_BLACKLIST=true
GEOBLOCK_COUNTRIES=CN,RU,KP

# Configurações do Antivírus ClamAV
CLAMAV_ENABLED=true
CLAMAV_SCAN_INTERVAL=60

# Configurações de Alertas do Sentinela / Monitor (SMTP / Telegram / SMS)
ALERT_CHANNEL_EMAIL=false
ALERT_CHANNEL_TELEGRAM=false
ALERT_CHANNEL_SMS=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_app
SMTP_FROM=alertas@charlescorrea.com.br
SMTP_TO=admin@charlescorrea.com.br

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMS_LEGAL_TOKEN=
SMS_LEGAL_TO=
