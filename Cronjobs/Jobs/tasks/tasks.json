      "enabled": true,
      "target_script": "/scripts/update_blocklist.sh",
      "target_container_pattern": "waf"
    },
    {
      "id": "waf-report-spam",
      "name": "Reporte de Invasores Capturados no Honeypot (StopForumSpam)",
      "schedule_hours": 1,
      "enabled": true,
      "target_script": "/scripts/report_spam.sh",
      "target_container_pattern": "waf"
    },
    {
      "id": "honeypot-blocklist-reload",
      "name": "Aplicar IPs capturados pelos Honeypots IA/Robots nos WAFs",
      "schedule_hours": 1,
      "enabled": true,
      "target_script": "/scripts/reload_waf_blocklist.sh",
      "target_container_pattern": "waf"
    },
    {
      "id": "ctir-gov-alert-check",
      "name": "Verificação Periódica de Alertas de Cibersegurança do CTIR Gov",
      "schedule_hours": 2,
      "enabled": true,
      "target_script": "python /app/ctir_gov_checker.py",
      "target_container_pattern": "monitor"
